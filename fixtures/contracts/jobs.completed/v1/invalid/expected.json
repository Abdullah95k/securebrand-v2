  },
  "capped-without-reason.json": {
    "path": [
      "capped_reason"
    ],
    "rule": "a capped job names its cap (ADR-0020)"
  },
  "coverage-days.json": {
    "path": [
      "coverage_days"
    ],
    "rule": "coverage_days goes (ADR-0017)"
  },
