{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]{4}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "iraqi_arabic",
        "msa",
        "sorani",
        "mixed",
        "english",
        "emoji",
        "urls",
        "hashtags",
        "digits",
        "unicode_edge",
        "fold_mode",
        "other",
        "und"
      ]
    },
    "lang": {
      "type": "string",
      "enum": [
        "ar",
        "ckb",
        "en",
        "mixed",
        "other",
        "und"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string"
    },
    "text_norm": {
      "type": "string"
    },
    "rows": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          },
          {
            "type": "string",
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5",
              "D6",
              "D7",
              "D8",
              "D-S1",
              "D-S2"
            ]
          }
        ]
      }
    },
    "anchor": {
      "type": "boolean"
    },
    "must_pass": {
      "type": "boolean",
      "const": true
    },
    "origin": {
      "type": "string",
      "enum": [
        "invented",
        "public_domain"
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewed": {
      "type": "boolean"
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "category",
    "lang",
    "title",
    "text",
    "text_norm",
    "rows",
    "anchor",
    "must_pass",
    "origin",
    "source",
    "reviewed",
    "note"
  ],
  "additionalProperties": false,
  "title": "fixtures/text/golden.jsonl line",
  "description": "One case of F7's golden fold corpus: an input under a language label and its expected text_norm (docs/plans/F7.md)."
}
