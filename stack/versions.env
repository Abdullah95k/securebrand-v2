# Image pins for the local stack (compose.yaml reads only these). For each image:
#   <NAME>_TAG       the exact tag
#   <NAME>_REPO      where `make up` pulls it from: an upstream that serves anonymous pulls
#                    (public.ecr.aws, ghcr.io, quay.io) when the publisher offers an official image
#                    there, else this repository's GHCR mirror (.github/workflows/mirror-images.yml)
#   <NAME>_UPSTREAM  the publisher's own registry; IMAGE_REGISTRY=upstream make up pulls from it
# Supabase's images are pinned by the Supabase CLI version in pnpm-workspace.yaml.

# Redpanda publishes only on Docker Hub (docker.redpanda.com redirects there): mirrored.
REDPANDA_TAG=v26.1.18
REDPANDA_REPO=ghcr.io/abdullah95k/securebrand-v2/redpanda
REDPANDA_UPSTREAM=docker.redpanda.com/redpandadata/redpanda

# ClickHouse's Docker Official Image, served anonymously by ECR Public (26.3 is the 2026 LTS).
CLICKHOUSE_TAG=26.3.38.2
CLICKHOUSE_REPO=public.ecr.aws/docker/library/clickhouse
CLICKHOUSE_UPSTREAM=docker.io/clickhouse/clickhouse-server

# SeaweedFS's own GHCR image (local S3; MinIO's community builds stopped, Garage is the fallback).
SEAWEEDFS_TAG=4.48
SEAWEEDFS_REPO=ghcr.io/chrislusf/seaweedfs
SEAWEEDFS_UPSTREAM=docker.io/chrislusf/seaweedfs
