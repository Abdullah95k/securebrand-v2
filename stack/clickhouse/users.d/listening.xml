<!-- The local stack's ClickHouse user; the values match stack/local.env (development only). -->
<clickhouse>
  <users>
    <listening>
      <password>listening-dev-only</password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>1</access_management>
      <named_collection_control>1</named_collection_control>
    </listening>
  </users>
</clickhouse>
