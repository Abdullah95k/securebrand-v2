<!-- Local development settings: quiet logs, a modest memory cap, no system log tables that only
     churn the disk. Production settings belong to I1. -->
<clickhouse>
  <logger>
    <level>warning</level>
    <console>1</console>
  </logger>
  <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <processors_profile_log remove="1"/>
  <part_log remove="1"/>
  <latency_log remove="1"/>
  <error_log remove="1"/>
  <query_metric_log remove="1"/>
</clickhouse>
