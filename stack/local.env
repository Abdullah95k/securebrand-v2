# Fixed development values of the local stack. They work on localhost only and guard nothing;
# real credentials come from the vault at run time and never live in the repository.
CLICKHOUSE_USER=listening
CLICKHOUSE_PASSWORD=listening-dev-only
S3_ACCESS_KEY_ID=listening-local
S3_SECRET_ACCESS_KEY=listening-dev-only
S3_REGION=us-east-1
S3_BUCKET=listening-local
