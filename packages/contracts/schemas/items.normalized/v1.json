        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "ItemAuthor": {
      "type": "object",
      "properties": {
        "author_ref": {
          "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
        },
        "author_type": { "type": "string", "enum": ["source", "individual"] },
        "author_source_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "display_name": { "type": "string" },
        "author_followers": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["author_ref", "author_type", "author_source_id"],
      "additionalProperties": false,
      "title": "ItemAuthor"
    },
    "Media": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" }
      },
      "required": ["type", "url"],
      "additionalProperties": false,
      "title": "Media"
    },
    "Metrics": {
      "type": "object",
      "properties": {
        "views": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "likes": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "comments": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "shares": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "reactions_by_type": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": { "$ref": "#/$defs/Count" }
            },
            { "type": "null" }
          ]
        },
        "saves": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      },
      "required": ["views", "likes", "comments", "shares", "reactions_by_type"],
      "additionalProperties": false,
      "title": "Metrics"
    },
    "Count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "title": "Count" },
    "UsageSignals": {
      "type": "object",
      "properties": {
        "search": { "type": "string", "enum": ["yes", "no", "unset"] },
        "ai_input": { "type": "string", "enum": ["yes", "no", "unset"] },
        "ai_train": { "type": "string", "enum": ["yes", "no", "unset"] }
      },
      "required": ["search", "ai_input", "ai_train"],
      "additionalProperties": false,
      "title": "UsageSignals"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    }
  }
}
