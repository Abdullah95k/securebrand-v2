{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "news.dedup/v1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "produced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "producer": { "$ref": "#/$defs/Producer" },
    "type": { "type": "string", "enum": ["verdict", "story_update"] },
    "item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^(((facebook|instagram|linkedin|telegram):(post|comment)|(tiktok|youtube):(video|comment)|x:post|news:comment):[^\\x00-\\x20]+|(news:article|web:result):[0-9a-f]{64})$"
    },
    "story_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "is_origin": { "type": "boolean" },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(((facebook|instagram|linkedin|telegram):(post|comment)|(tiktok|youtube):(video|comment)|x:post|news:comment):[^\\x00-\\x20]+|(news:article|web:result):[0-9a-f]{64})$"
        },
        { "type": "null" }
      ]
    },
    "cluster_size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "rank_in_cluster": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "origin_source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "origin_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "matched_by": {
      "anyOf": [
        { "type": "string", "enum": ["simhash", "canonical", "text_sha256", "title_sha256"] },
        { "type": "null" }
      ]
    },
    "hamming_distance": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "title_overlap": {
      "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "decided_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "previous_story_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "previous_origin": {
      "type": "string",
      "pattern": "^(((facebook|instagram|linkedin|telegram):(post|comment)|(tiktok|youtube):(video|comment)|x:post|news:comment):[^\\x00-\\x20]+|(news:article|web:result):[0-9a-f]{64})$"
    },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "retention_class": {
      "type": "string",
      "enum": [
        "meta_on_request",
        "vendor_agreed",
        "x_24h_sync",
        "news_excerpt",
        "telegram_bot",
        "tiktok_display",
        "linkedin_48h",
        "linkedin_org",
        "youtube_30d_text"
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "produced_at",
    "producer",
    "type",
    "item_id",
    "idempotency_key",
    "story_id",
    "is_origin",
    "duplicate_of",
    "cluster_size",
    "version",
    "rank_in_cluster",
    "origin_source_id",
    "origin_time",
    "matched_by",
    "hamming_distance",
    "title_overlap",
    "source_id",
    "decided_at",
    "provenance",
    "retention_class"
  ],
  "additionalProperties": false,
  "title": "NewsDedupV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    }
  }
}
