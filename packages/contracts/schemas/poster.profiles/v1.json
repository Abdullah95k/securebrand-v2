      "additionalProperties": false,
      "title": "CountrySignals"
    },
    "SignalEvidence": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "iraqi_place",
            "platform_country_iq",
            "phone_964",
            "iq_domain",
            "outlet_link",
            "seed_list"
          ]
        },
        "matched": { "type": "string", "minLength": 1 },
        "where": { "type": "string", "minLength": 1 }
      },
      "required": ["signal", "matched", "where"],
      "additionalProperties": false,
      "title": "SignalEvidence"
    },
    "LangShare": {
      "type": "object",
      "properties": {
        "ar": { "type": "number", "minimum": 0, "maximum": 1 },
        "ckb": { "type": "number", "minimum": 0, "maximum": 1 },
        "en": { "type": "number", "minimum": 0, "maximum": 1 },
        "mixed": { "type": "number", "minimum": 0, "maximum": 1 },
        "other": { "type": "number", "minimum": 0, "maximum": 1 },
        "und": { "type": "number", "minimum": 0, "maximum": 1 },
        "ar_iraqi": { "type": "number", "minimum": 0, "maximum": 1 },
        "sample": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["ar", "ckb", "en", "mixed", "other", "und", "ar_iraqi", "sample"],
      "additionalProperties": false,
      "title": "LangShare"
    },
