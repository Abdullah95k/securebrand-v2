      "additionalProperties": false,
      "title": "Provenance"
    },
    "CountrySignals": {
      "type": "object",
      "properties": {
        "iraqi_place": { "type": "boolean" },
        "platform_country_iq": { "type": "boolean" },
        "phone_964": { "type": "boolean" },
        "iq_domain": { "type": "boolean" },
        "outlet_link": { "type": "boolean" },
        "seed_list": { "type": "boolean" },
        "signal_evidence": { "type": "array", "items": { "$ref": "#/$defs/SignalEvidence" } }
