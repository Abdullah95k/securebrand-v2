{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "search.results/v1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "produced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "producer": { "$ref": "#/$defs/Producer" },
    "engine": { "type": "string", "enum": ["perplexity", "mojeek", "gdelt"] },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "keyword_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "query": { "$ref": "#/$defs/SearchRequest" },
    "result": { "$ref": "#/$defs/SearchHit" },
    "canonical_url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
    "canonical_url_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "raw_ref": {
      "type": "string",
      "pattern": "^raw\\/(green|amber)\\/(facebook|instagram|tiktok|x|linkedin|telegram|youtube|news|web)\\/[0-9]{4}\\/(0[1-9]|1[0-2])\\/(0[1-9]|[12][0-9]|3[01])\\/[a-z0-9]+(-[a-z0-9]+)*\\/[0-9]{6}\\.jsonl\\.zst#[0-9]+$"
    },
    "hints": { "$ref": "#/$defs/GdeltHints" },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "retention_class": {
      "type": "string",
      "enum": [
        "meta_on_request",
        "vendor_agreed",
        "x_24h_sync",
        "news_excerpt",
        "telegram_bot",
        "tiktok_display",
        "linkedin_48h",
        "linkedin_org",
        "youtube_30d_text"
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "produced_at",
    "producer",
    "engine",
    "source_id",
    "keyword_ids",
    "client_ids",
    "query",
    "result",
    "canonical_url",
    "canonical_url_hash",
    "raw_ref",
    "provenance",
    "retention_class"
  ],
  "additionalProperties": false,
  "title": "SearchResultsV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "SearchRequest": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "variant": {
          "anyOf": [{ "type": "string", "pattern": "^[^\\x00-\\x20]+$" }, { "type": "null" }]
        },
        "lang": {
          "anyOf": [{ "type": "string", "pattern": "^[^\\x00-\\x20]+$" }, { "type": "null" }]
        },
        "country": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{2}$" }, { "type": "null" }] },
        "request_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "required": ["text", "variant", "lang", "country", "request_id"],
      "additionalProperties": false,
      "title": "SearchRequest"
    },
    "SearchHit": {
      "type": "object",
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "title": { "type": ["string", "null"] },
        "url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
        "snippet": { "type": ["string", "null"] },
        "date": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
            { "type": "null" }
          ]
        },
        "last_updated": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
            { "type": "null" }
          ]
        }
      },
      "required": ["rank", "title", "url", "snippet", "date", "last_updated"],
      "additionalProperties": false,
      "title": "SearchHit"
    },
    "GdeltHints": {
      "type": "object",
      "properties": {
        "domain": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\\.?$"
            },
            { "type": "null" }
          ]
        },
        "language": { "type": ["string", "null"] },
        "source_country": { "type": ["string", "null"] }
      },
      "required": ["domain", "language", "source_country"],
      "additionalProperties": false,
      "title": "GdeltHints"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    }
  }
}
