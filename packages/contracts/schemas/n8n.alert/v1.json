{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "n8n.alert/v1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "produced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "producer": { "$ref": "#/$defs/Producer" },
    "alert_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "enum": ["email", "telegram", "slack", "webhook"] },
    "fallthrough_channel": {
      "anyOf": [{ "type": "string", "enum": ["email", "telegram", "slack"] }, { "type": "null" }]
    },
    "audience": { "type": "string", "enum": ["client", "ops", "account_manager"] },
    "client_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        { "type": "null" }
      ]
    },
    "alert": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "severity": { "type": "string", "enum": ["info", "warning", "high"] },
    "subject": { "$ref": "#/$defs/AlertSubject" },
    "summary": { "type": "string", "minLength": 1 },
    "details": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "volume_spike" },
                "metrics": { "$ref": "#/$defs/VolumeSpikeMetrics" }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "VolumeSpikeAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "negative_share" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "NegativeShareAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "new_high_reach_poster" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "NewHighReachPosterAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "keyword_first_seen" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "KeywordFirstSeenAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "post_deleted_high_reach" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "PostDeletedHighReachAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "engagement_spike" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "EngagementSpikeAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "topic_spike" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "TopicSpikeAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "entity_or_logo" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "EntityOrLogoAlert"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "renotify": { "type": "boolean" },
                "keyword": { "$ref": "#/$defs/AlertKeyword" },
                "scope": { "$ref": "#/$defs/AlertScope" },
                "window": { "$ref": "#/$defs/AlertWindow" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "cooldown_until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
                },
                "rule_type": { "type": "string", "const": "story" },
                "metrics": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "number" }
                }
              },
              "required": [
                "rule_id",
                "renotify",
                "window",
                "fingerprint",
                "cooldown_until",
                "rule_type",
                "metrics"
              ],
              "additionalProperties": false,
              "title": "StoryAlert"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "subject_kind": { "type": "string", "enum": ["source", "route"] },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "platform": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram",
                "tiktok",
                "x",
                "linkedin",
                "telegram",
                "youtube",
                "news",
                "web"
              ]
            },
            "route": { "type": "string", "enum": ["green", "amber"] },
            "reason": {
              "type": "string",
              "enum": [
                "bot_removed",
                "privacy_mode",
                "grant_missing",
                "account_unavailable",
                "credential_revoked",
                "not_found",
                "uploads_playlist_missing",
                "query_rejected",
                "feed_gone",
                "push_gap",
                "crawl_disallowed",
                "flag_off",
                "flag_on",
                "empty_200_rate",
                "low_yield",
                "server",
                "auth",
                "lease_lapsed",
                "subscription_failed",
                "owner_request",
                "authorization_revoked",
                "budget_wait",
                "client_removed",
                "review_timeout",
                "amber_excluded_government",
                "age_gated",
                "not_indexed",
                "unclassified",
                "ambiguous",
                "schema_unknown"
              ]
            },
            "vendor": {
              "anyOf": [
                { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                { "type": "null" }
              ]
            }
          },
          "required": ["subject_kind", "reason", "vendor"],
          "additionalProperties": false,
          "title": "FallbackNotice"
        },
        {
          "type": "object",
          "properties": { "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" } } },
          "required": ["facts"],
          "additionalProperties": false,
          "title": "FactsNotice"
        }
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "produced_at",
    "producer",
    "alert_id",
    "idempotency_key",
    "channel",
    "fallthrough_channel",
    "audience",
    "client_id",
    "alert",
    "severity",
    "subject",
    "summary",
    "details"
  ],
  "additionalProperties": false,
  "title": "N8nAlertV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "AlertSubject": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "facebook",
            "instagram",
            "tiktok",
            "x",
            "linkedin",
            "telegram",
            "youtube",
            "news",
            "web"
          ]
        },
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "keyword_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "candidate_key": {
          "type": "string",
          "pattern": "^(facebook:group:[0-9]+|news:site:[a-z0-9-]+(\\.[a-z0-9-]+)+|(facebook|instagram|tiktok|x|telegram|youtube):[^\\x00-\\x20:]+|linkedin:[^\\x00-\\x20]+)$"
        },
        "request_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "additionalProperties": false,
      "title": "AlertSubject"
    },
    "AlertKeyword": {
      "type": "object",
      "properties": {
        "keyword_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "label": { "type": "string", "minLength": 1 },
        "purpose": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, { "type": "null" }]
        }
      },
      "required": ["keyword_id", "label", "purpose"],
      "additionalProperties": false,
      "title": "AlertKeyword"
    },
    "AlertScope": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "platform": {
          "type": "string",
          "enum": [
            "facebook",
            "instagram",
            "tiktok",
            "x",
            "linkedin",
            "telegram",
            "youtube",
            "news",
            "web"
          ]
        },
        "source": { "$ref": "#/$defs/AlertSource" },
        "item_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "topic_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+:[^\\x00-\\x20]+$" },
        "entity_id": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
        "brand_id": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
        "story_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "additionalProperties": false,
      "title": "AlertScope"
    },
    "AlertSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "display_name": { "type": "string" }
      },
      "required": ["source_id", "display_name"],
      "additionalProperties": false,
      "title": "AlertSource"
    },
    "AlertWindow": {
      "type": "object",
      "properties": {
        "hour": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "elapsed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "evaluated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["hour", "elapsed_fraction", "evaluated_at"],
      "additionalProperties": false,
      "title": "AlertWindow"
    },
    "VolumeSpikeMetrics": {
      "type": "object",
      "properties": {
        "mentions_so_far": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "baseline_median_same_hour": { "type": "number", "minimum": 0 },
        "expected_so_far": { "type": "number", "minimum": 0 },
        "ratio": { "type": "number", "minimum": 0 },
        "baseline_days": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": [
        "mentions_so_far",
        "baseline_median_same_hour",
        "expected_so_far",
        "ratio",
        "baseline_days"
      ],
      "additionalProperties": false,
      "title": "VolumeSpikeMetrics"
    },
    "Fact": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "required": ["label", "value"],
      "additionalProperties": false,
      "title": "Fact"
    }
  }
}
