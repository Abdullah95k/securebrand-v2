  "title": "DeletionsV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "ItemTarget": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "facebook",
            "instagram",
            "tiktok",
            "x",
            "linkedin",
            "telegram",
            "youtube",
            "news",
            "web"
          ]
        },
        "kind": { "type": "string", "enum": ["post", "video", "comment", "article", "result"] },
        "item_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" }
        },
        "fetched_before": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "countries": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "user_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" }
        }
      },
      "required": ["platform", "kind", "item_ids"],
      "additionalProperties": false,
      "title": "ItemTarget"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    },
    "SubjectTarget": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "facebook",
            "instagram",
            "tiktok",
            "x",
            "linkedin",
            "telegram",
            "youtube",
            "news",
            "web"
          ]
        },
        "kind": { "type": "string", "enum": ["post", "video", "comment", "article", "result"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" }
        },
        "item_ids": {
          "type": "array",
          "items": {
