        "keyword_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "keyword_set_version": { "type": "string", "pattern": "^cs:[0-9a-f]{64}$" },
        "lang_model_version": {
          "anyOf": [{ "type": "string", "pattern": "^[^\\x00-\\x20]+$" }, { "type": "null" }]
        },
        "hit_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "url": {
          "anyOf": [
            { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
            { "type": "null" }
          ]
        },
        "poster": { "$ref": "#/$defs/HitPoster" },
        "video_channel_id": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
        "raw_ref": {
          "type": "string",
          "pattern": "^raw\\/(green|amber)\\/(facebook|instagram|tiktok|x|linkedin|telegram|youtube|news|web)\\/[0-9]{4}\\/(0[1-9]|1[0-2])\\/(0[1-9]|[12][0-9]|3[01])\\/[a-z0-9]+(-[a-z0-9]+)*\\/[0-9]{6}\\.jsonl\\.zst#[0-9]+$"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
            },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "retention_class": {
          "type": "string",
          "enum": [
            "meta_on_request",
            "vendor_agreed",
            "x_24h_sync",
            "news_excerpt",
            "telegram_bot",
            "tiktok_display",
            "linkedin_48h",
            "linkedin_org",
            "youtube_30d_text"
          ]
        },
        "matched_by": { "type": "string", "const": "text" },
        "matched_term": { "type": "string", "minLength": 1 },
        "form_id": { "type": "string", "minLength": 1 },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offsets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        "offsets_in": { "type": "string", "const": "text_norm" }
      },
      "required": [
        "schema",
        "message_id",
        "produced_at",
        "producer",
        "hit_id",
        "status",
        "item_id",
        "item_version",
        "platform",
        "kind",
        "source_id",
        "client_id",
        "keyword_id",
        "keyword_set_version",
        "lang_model_version",
        "hit_at",
        "url",
        "poster",
        "raw_ref",
        "expires_at",
        "provenance",
        "retention_class",
        "matched_by",
        "matched_term",
        "form_id",
        "occurrences",
        "offsets",
        "offsets_in"
      ],
      "additionalProperties": false,
      "title": "TextHit"
    },
