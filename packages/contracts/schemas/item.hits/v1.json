            "facebook",
            "instagram",
            "tiktok",
            "x",
            "linkedin",
            "telegram",
            "youtube",
            "news",
            "web"
          ]
        },
        "kind": { "type": "string", "enum": ["post", "video", "comment", "article", "result"] },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
