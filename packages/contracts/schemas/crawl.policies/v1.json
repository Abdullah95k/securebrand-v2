{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "crawl.policies/v1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "produced_at": {
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "producer": { "$ref": "#/$defs/Producer" },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\\.?$"
    },
    "status": { "type": "string", "enum": ["allowed", "disallowed", "paywalled", "blocked"] },
    "crawl_allowed": { "type": "boolean" },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "robots_unreachable",
            "content_signal_search_no",
            "robots_disallowed",
            "rsl_prohibited",
            "rsl_payment",
            "http_402",
            "challenge"
          ]
        },
        { "type": "null" }
      ]
    },
    "access_mode": { "type": "string", "enum": ["direct", "headless", "proxy", "blocked"] },
    "crawl_delay_seconds": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "robots_status": { "type": "string", "enum": ["ok", "unavailable"] },
    "robots_rules": { "anyOf": [{ "$ref": "#/$defs/RobotsRules" }, { "type": "null" }] },
    "usage_signals": { "$ref": "#/$defs/UsageSignals" },
    "rsl": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "found": { "type": "boolean", "const": false } },
          "required": ["found"],
          "additionalProperties": false,
          "title": "RslAbsent"
        },
        {
          "type": "object",
          "properties": {
            "found": { "type": "boolean", "const": true },
            "url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
            "permits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "prohibits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "payment": { "anyOf": [{ "$ref": "#/$defs/RslPayment" }, { "type": "null" }] }
          },
          "required": ["found", "url", "permits", "prohibits", "payment"],
          "additionalProperties": false,
          "title": "RslFound"
        }
      ]
    },
    "payment": { "$ref": "#/$defs/Http402" },
    "checked_at": {
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "policy_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "changed_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requested_by": {
      "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }]
    },
    "kind": { "type": "string", "enum": ["first_check", "refresh", "recheck", "ops_force"] },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "retention_class": {
      "type": "string",
      "enum": [
        "meta_on_request",
        "vendor_agreed",
        "x_24h_sync",
        "news_excerpt",
        "telegram_bot",
        "tiktok_display",
        "linkedin_48h",
        "linkedin_org",
        "youtube_30d_text"
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "produced_at",
    "producer",
    "host",
    "status",
    "crawl_allowed",
    "reason",
    "access_mode",
    "crawl_delay_seconds",
    "robots_status",
    "robots_rules",
    "usage_signals",
    "rsl",
    "payment",
    "checked_at",
    "expires_at",
    "policy_version",
    "changed_fields",
    "requested_by",
    "kind",
    "provenance",
    "retention_class"
  ],
  "additionalProperties": false,
  "title": "CrawlPoliciesV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "RobotsRules": {
      "type": "object",
      "properties": {
        "group": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "rules": { "$ref": "#/$defs/RobotsRuleLists" },
        "sitemaps": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" }
        },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["group", "rules", "sitemaps", "hash"],
      "additionalProperties": false,
      "title": "RobotsRules"
    },
    "RobotsRuleLists": {
      "type": "object",
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "disallow": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["allow", "disallow"],
      "additionalProperties": false,
      "title": "RobotsRuleLists"
    },
    "UsageSignals": {
      "type": "object",
      "properties": {
        "search": { "type": "string", "enum": ["yes", "no", "unset"] },
        "ai_input": { "type": "string", "enum": ["yes", "no", "unset"] },
        "ai_train": { "type": "string", "enum": ["yes", "no", "unset"] }
      },
      "required": ["search", "ai_input", "ai_train"],
      "additionalProperties": false,
      "title": "UsageSignals"
    },
    "RslPayment": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "amount": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }
      },
      "required": ["type", "amount"],
      "additionalProperties": false,
      "title": "RslPayment"
    },
    "Http402": {
      "type": "object",
      "properties": { "http_402": { "type": "boolean" }, "price": { "type": ["string", "null"] } },
      "required": ["http_402", "price"],
      "additionalProperties": false,
      "title": "Http402"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    }
  }
}
