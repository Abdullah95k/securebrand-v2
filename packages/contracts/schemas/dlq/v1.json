{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "pattern": "^dlq\\.[a-z0-9]+(-[a-z0-9]+)*\\/v1$" },
        "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "produced_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "producer": { "$ref": "#/$defs/Producer" },
        "message": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "raw": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "error": { "$ref": "#/$defs/DeadLetterError" },
        "provenance": { "$ref": "#/$defs/SignalProvenance" },
        "retention_class": {
          "type": "string",
          "enum": [
            "meta_on_request",
            "vendor_agreed",
            "x_24h_sync",
            "news_excerpt",
            "telegram_bot",
            "tiktok_display",
            "linkedin_48h",
            "linkedin_org",
            "youtube_30d_text"
          ]
        },
        "stage": { "type": "string", "const": "consume" },
        "original": { "$ref": "#/$defs/ConsumedOriginal" },
        "consumer": { "$ref": "#/$defs/ConsumerGroup" }
      },
      "required": [
        "schema",
        "message_id",
        "produced_at",
        "producer",
        "error",
        "stage",
        "original",
        "consumer"
      ],
      "additionalProperties": false,
      "title": "ConsumeDeadLetter"
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "pattern": "^dlq\\.[a-z0-9]+(-[a-z0-9]+)*\\/v1$" },
        "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "produced_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "producer": { "$ref": "#/$defs/Producer" },
        "message": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "raw": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "error": { "$ref": "#/$defs/DeadLetterError" },
        "provenance": { "$ref": "#/$defs/SignalProvenance" },
        "retention_class": {
          "type": "string",
          "enum": [
            "meta_on_request",
            "vendor_agreed",
            "x_24h_sync",
            "news_excerpt",
            "telegram_bot",
            "tiktok_display",
            "linkedin_48h",
            "linkedin_org",
            "youtube_30d_text"
          ]
        },
        "stage": { "type": "string", "const": "produce" },
        "original": { "$ref": "#/$defs/ProducedOriginal" },
        "consumer": { "$ref": "#/$defs/ProducingService" }
      },
      "required": [
        "schema",
        "message_id",
        "produced_at",
        "producer",
        "error",
        "stage",
        "original",
        "consumer"
      ],
      "additionalProperties": false,
      "title": "ProduceDeadLetter"
    }
  ],
  "title": "DlqV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "DeadLetterError": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "schema_unknown",
            "invalid",
            "producer_not_allowed",
            "attempts_exhausted",
            "query_rejected"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "first_failed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "last_failed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["class", "message", "attempts", "first_failed_at", "last_failed_at"],
      "additionalProperties": false,
      "title": "DeadLetterError"
    },
    "SignalProvenance": {
      "type": "object",
      "properties": {
        "route": {
          "anyOf": [{ "type": "string", "enum": ["green", "amber"] }, { "type": "null" }]
        },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "SignalProvenance"
    },
    "ConsumedOriginal": {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
        "partition": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "key": { "type": ["string", "null"] },
        "schema": {
          "anyOf": [{ "type": "string", "pattern": "^[^\\x00-\\x20]+$" }, { "type": "null" }]
        },
        "message_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
            { "type": "null" }
          ]
        }
      },
      "required": ["topic", "partition", "offset", "key", "schema", "message_id"],
      "additionalProperties": false,
      "title": "ConsumedOriginal"
    },
    "ConsumerGroup": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "group": { "type": "string", "minLength": 1 }
      },
      "required": ["service", "group"],
      "additionalProperties": false,
      "title": "ConsumerGroup"
    },
    "ProducedOriginal": {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
        "partition": { "type": "null" },
        "offset": { "type": "null" },
        "key": { "type": ["string", "null"] },
        "schema": {
          "anyOf": [{ "type": "string", "pattern": "^[^\\x00-\\x20]+$" }, { "type": "null" }]
        },
        "message_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
            { "type": "null" }
          ]
        }
      },
      "required": ["topic", "partition", "offset", "key", "schema", "message_id"],
      "additionalProperties": false,
      "title": "ProducedOriginal"
    },
    "ProducingService": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "group": { "type": "null" }
      },
      "required": ["service", "group"],
      "additionalProperties": false,
      "title": "ProducingService"
    }
  }
}
