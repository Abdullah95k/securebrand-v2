        "schema",
        "message_id",
        "produced_at",
        "producer",
        "candidate",
        "item_id",
        "url",
        "source_id",
        "keyword_ids",
        "client_ids",
        "hit_at",
        "provenance",
        "retention_class",
        "evidence_type"
