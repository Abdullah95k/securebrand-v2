{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "item.metrics/v1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "produced_at": {
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "producer": { "$ref": "#/$defs/Producer" },
    "item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^(((facebook|instagram|linkedin|telegram):(post|comment)|(tiktok|youtube):(video|comment)|x:post|news:comment):[^\\x00-\\x20]+|(news:article|web:result):[0-9a-f]{64})$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "tiktok",
        "x",
        "linkedin",
        "telegram",
        "youtube",
        "news",
        "web"
      ]
    },
    "platform_id": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        { "type": "null" }
      ]
    },
    "observation": { "$ref": "#/$defs/Observation" },
    "metrics": { "$ref": "#/$defs/Metrics" },
    "channel_id": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
    "live_state": { "type": "string", "enum": ["none", "upcoming", "live"] },
    "regressed": { "type": "boolean" },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "retention_class": {
      "type": "string",
      "enum": [
        "meta_on_request",
        "vendor_agreed",
        "x_24h_sync",
        "news_excerpt",
        "telegram_bot",
        "tiktok_display",
        "linkedin_48h",
        "linkedin_org",
        "youtube_30d_text"
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "produced_at",
    "producer",
    "item_id",
    "idempotency_key",
    "platform",
    "platform_id",
    "source_id",
    "created_at",
    "observation",
    "metrics",
    "provenance",
    "retention_class"
  ],
  "additionalProperties": false,
  "title": "ItemMetricsV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "Observation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "label": { "type": "string", "const": "refresh" },
            "step": {
              "type": "string",
              "pattern": "^(\\+24h|\\+7d|refresh:[0-7][0-9A-HJKMNP-TV-Z]{25})$"
            },
            "observed_at": {
              "type": "string",
              "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
            }
          },
          "required": ["label", "step", "observed_at"],
          "additionalProperties": false,
          "title": "RefreshObservation"
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "enum": ["first_sight", "poll", "backfill", "ops_force", "live_end"]
            },
            "step": { "type": "null" },
            "observed_at": {
              "type": "string",
              "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
            }
          },
          "required": ["label", "step", "observed_at"],
          "additionalProperties": false,
          "title": "ReadObservation"
        }
      ],
      "title": "Observation"
    },
    "Metrics": {
      "type": "object",
      "properties": {
        "views": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "likes": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "comments": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "shares": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "reactions_by_type": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": { "$ref": "#/$defs/Count" }
            },
            { "type": "null" }
          ]
        },
        "saves": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      },
      "required": ["views", "likes", "comments", "shares", "reactions_by_type"],
      "additionalProperties": false,
      "title": "Metrics"
    },
    "Count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "title": "Count" },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    }
  }
}
