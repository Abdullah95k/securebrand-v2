  "title": "N8nCardV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "CardSubject": {
      "type": "object",
      "properties": {
        "candidate_key": {
          "type": "string",
          "pattern": "^(facebook:group:[0-9]+|news:site:[a-z0-9-]+(\\.[a-z0-9-]+)+|(facebook|instagram|tiktok|x|telegram|youtube):[^\\x00-\\x20:]+|linkedin:[^\\x00-\\x20]+)$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "decision_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "request_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "additionalProperties": false,
      "title": "CardSubject"
    },
    "Fact": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "required": ["label", "value"],
      "additionalProperties": false,
      "title": "Fact"
    },
    "CardButton": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["approve_tier_1", "approve_tier_2", "approve_tier_3", "reject", "mention_only"]
        },
        "label": { "type": "string", "minLength": 1 }
      },
      "required": ["action", "label"],
      "additionalProperties": false,
      "title": "CardButton"
    },
    "CardInput": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["url", "text"] }
      },
      "required": ["name", "label", "kind"],
      "additionalProperties": false,
      "title": "CardInput"
    }
  }
}
