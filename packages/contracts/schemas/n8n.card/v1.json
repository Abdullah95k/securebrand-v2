        "audience": { "type": "string", "enum": ["client", "ops", "account_manager"] },
        "client_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "subject": { "$ref": "#/$defs/CardSubject" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "opened_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "card_type": { "type": "string", "const": "qualifier_review" },
        "buttons": { "minItems": 1, "type": "array", "items": { "$ref": "#/$defs/CardButton" } },
        "default_action": { "type": "string", "const": "reject" },
        "timeout_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": [
        "schema",
        "message_id",
        "produced_at",
        "producer",
        "card_id",
        "idempotency_key",
        "channel",
        "audience",
        "client_id",
        "subject",
        "title",
        "summary",
        "facts",
        "opened_at",
        "card_type",
        "buttons",
        "default_action",
        "timeout_at"
      ],
      "additionalProperties": false,
      "title": "QualifierReviewCard"
    },
