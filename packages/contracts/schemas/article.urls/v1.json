{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "article.urls/v1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "produced_at": {
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "producer": { "$ref": "#/$defs/Producer" },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
    "url_key": { "type": "string", "pattern": "^news:url:[0-9a-f]{64}$" },
    "found_via": {
      "type": "string",
      "enum": [
        "feed",
        "news_sitemap",
        "homepage_diff",
        "sitemap_backfill",
        "web_search",
        "commoncrawl"
      ]
    },
    "found_at": {
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "title": { "type": "string" },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        { "type": "null" }
      ]
    },
    "feed_url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
    "feed_format": { "type": "string", "minLength": 1 },
    "canonical_url": { "type": "string", "pattern": "^https?:\\/\\/[^\\x00-\\x20]+$" },
    "canonical_url_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snippet": { "type": "string" },
    "engines": {
      "type": "array",
      "items": { "type": "string", "enum": ["perplexity", "mojeek", "gdelt"] }
    },
    "keyword_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "retention_class": {
      "type": "string",
      "enum": [
        "meta_on_request",
        "vendor_agreed",
        "x_24h_sync",
        "news_excerpt",
        "telegram_bot",
        "tiktok_display",
        "linkedin_48h",
        "linkedin_org",
        "youtube_30d_text"
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "produced_at",
    "producer",
    "source_id",
    "url",
    "url_key",
    "found_via",
    "found_at",
    "provenance",
    "retention_class"
  ],
  "additionalProperties": false,
  "title": "ArticleUrlsV1",
  "$defs": {
    "Producer": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\x00-\\x20]+$" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      },
      "required": ["service", "version", "job_id"],
      "additionalProperties": false,
      "title": "Producer"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "route": { "type": "string", "enum": ["green", "amber"] },
        "vendor": {
          "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }]
        },
        "service": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fetched_at": {
          "type": "string",
          "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["route", "vendor", "service", "fetched_at"],
      "additionalProperties": false,
      "title": "Provenance"
    }
  }
}
