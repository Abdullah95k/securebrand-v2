  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "const": "jobs.completed/v1" },
        "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "produced_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "producer": { "$ref": "#/$defs/Producer" },
        "job_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "queue": { "type": "string", "pattern": "^jobs\\.[a-z0-9]+(-[a-z0-9]+)*(\\.priority)?$" },
        "kind": {
          "type": "string",
          "enum": [
            "rotation",
            "reconciliation",
            "backfill",
            "keyword_history",
            "comments",
            "replies",
            "metrics",
            "first_sight",
            "refresh",
            "resolve",
            "manual_candidate",
            "first_check",
            "recheck",
            "ops_force",
            "push",
            "replay",
            "rerun",
            "rematch",
            "recompute",
            "retention_sweep",
            "analyze",
            "candidate_retry",
            "review_answer",
            "export"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "candidate_key": {
          "type": "string",
          "pattern": "^(facebook:group:[0-9]+|news:site:[a-z0-9-]+(\\.[a-z0-9-]+)+|(facebook|instagram|tiktok|x|telegram|youtube):[^\\x00-\\x20:]+|linkedin:[^\\x00-\\x20]+)$"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\\.?$"
        },
        "crawl_id": { "type": "string", "pattern": "^[^\\x00-\\x20]+$" },
        "client_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "run_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "request_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "post_ref": { "$ref": "#/$defs/PostRef" },
        "series_step": {
          "type": "string",
          "pattern": "^(\\+[1-9][0-9]*[hd]|once|hot:[1-9][0-9]*|refresh:[0-7][0-9A-HJKMNP-TV-Z]{25})$"
        },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "finished_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "report": { "$ref": "#/$defs/Report" },
        "oldest_item_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
            },
            { "type": "null" }
          ]
        },
        "complete": { "type": "boolean" },
        "stored_before": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "comments_total": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "paid_user_reads": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "free_rereads": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "gap_unfilled": { "anyOf": [{ "$ref": "#/$defs/UncoveredWindow" }, { "type": "null" }] },
        "uncovered": { "anyOf": [{ "$ref": "#/$defs/UncoveredWindow" }, { "type": "null" }] },
        "status": { "type": "string", "const": "done" },
        "reason": { "type": "null" }
      },
      "required": [
        "schema",
        "message_id",
        "produced_at",
        "producer",
        "job_id",
        "queue",
        "kind",
        "attempt",
        "finished_at",
        "report",
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "title": "DoneReport"
    },
